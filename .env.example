# Generated by ./scripts/init.sh - never commit the real .env
SESSION_SECRET=REPLACE_ME_WITH_64_CHARACTER_RANDOM_STRING
SESSION_SECURE=false
DT_DATA_DIR=./data
# From Zoom App Marketplace > General App > Embed > Meeting SDK
ZOOM_MEETING_SDK_CLIENT_ID=
ZOOM_MEETING_SDK_CLIENT_SECRET=
# From Zoom App Marketplace > Server-to-Server OAuth App
ZOOM_ACCOUNT_ID=
ZOOM_S2S_CLIENT_ID=
ZOOM_S2S_CLIENT_SECRET=
# Optional: email the office desktop recorder uses when it joins a webinar as an attendee
ZOOM_RECORDER_EMAIL=
# Optional legacy callback; not required for administrator-managed faculty access
ZOOM_OAUTH_REDIRECT_URI=
